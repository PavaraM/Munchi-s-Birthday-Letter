<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>for Munchi Panchi 🌸</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌸</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Mrs+Saint+Delafield&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ============================================================
   CONFIG-ADJACENT NOTE FOR PAVARA:
   Her display name + birthday are set in the <script> CONFIG
   block near the bottom of this file. The actual LETTER TEXT
   lives near the end of the HTML body, clearly marked.
   ============================================================ */

:root{
  --hot-pink:#FF3FA4;
  --deep-pink:#C2185B;
  --baby-pink:#FFD6EC;
  --lilac:#C9A6FF;
  --lilac-light:#E8DBFF;
  --gold:#D4A847;
  --gold-light:#F2D88F;
  --amber:#C8682E;
  --amber-light:#EFA15C;
  --cream:#FFF8F0;
  --ink:#3A1A2E;
  --font-display:'Mrs Saint Delafield', cursive;
  --font-body:'Cormorant Garamond', serif;
  --font-ui:'Quicksand', sans-serif;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;height:100%;overflow:hidden;}
body{
  font-family:var(--font-ui);
  color:var(--ink);
  background:#1a0f17;
  position:relative;
  -webkit-tap-highlight-color:transparent;
}
button{font-family:inherit;border:none;background:none;cursor:pointer;-webkit-tap-highlight-color:transparent;}
h1,h2,h3{margin:0;font-weight:400;}
p{margin:0;}

/* ---------- ambient particle canvas ---------- */
#ambient{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  z-index:1;
  pointer-events:none;
}

/* ---------- persistent UI chrome ---------- */
#countdown-chip{
  position:fixed;
  top:18px;
  left:50%;
  transform:translateX(-50%);
  z-index:50;
  background:rgba(58,26,46,.55);
  backdrop-filter:blur(6px);
  border:1px solid rgba(255,255,255,.25);
  color:#fff;
  font-family:var(--font-ui);
  font-weight:600;
  font-size:clamp(.7rem,2vw,.85rem);
  letter-spacing:.03em;
  padding:7px 16px;
  border-radius:30px;
  text-align:center;
  white-space:nowrap;
}
#countdown-chip span.num{color:var(--gold-light);}

#mute-btn{
  position:fixed;
  bottom:18px;
  right:18px;
  z-index:50;
  width:42px;
  height:42px;
  border-radius:50%;
  background:rgba(58,26,46,.55);
  border:1px solid rgba(255,255,255,.25);
  color:#fff;
  font-size:18px;
  display:flex;
  align-items:center;
  justify-content:center;
  backdrop-filter:blur(6px);
}

#progress-dots{
  position:fixed;
  bottom:18px;
  left:50%;
  transform:translateX(-50%);
  z-index:50;
  display:flex;
  gap:8px;
}
#progress-dots .dot{
  width:7px;height:7px;border-radius:50%;
  background:rgba(255,255,255,.3);
  transition:background .4s ease, transform .4s ease;
}
#progress-dots .dot.filled{background:var(--gold-light);transform:scale(1.3);}

/* ---------- stage system ---------- */
.stage{
  position:fixed;
  inset:0;
  z-index:10;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:90px 24px 80px;
  opacity:0;
  pointer-events:none;
  transition:opacity .9s ease;
}
.stage.active{opacity:1;pointer-events:auto;}
.stage-content{
  max-width:560px;
  width:100%;
  text-align:center;
  transform:translateY(18px);
  opacity:0;
  transition:transform .8s cubic-bezier(.2,.8,.2,1) .15s, opacity .8s ease .15s;
}
.stage.active .stage-content{transform:translateY(0);opacity:1;}

.eyebrow{
  font-family:var(--font-ui);
  font-size:.75rem;
  letter-spacing:.25em;
  text-transform:uppercase;
  opacity:.7;
  margin-bottom:10px;
}
.stage-title{
  font-family:var(--font-display);
  font-size:clamp(3rem,10vw,5.2rem);
  line-height:1;
  margin-bottom:14px;
}
.stage-sub{
  font-family:var(--font-body);
  font-style:italic;
  font-size:clamp(1.05rem,2.6vw,1.3rem);
  opacity:.9;
  margin-bottom:34px;
}

.combo-display{
  font-family:var(--font-ui);
  font-size:.9rem;
  font-weight:700;
  letter-spacing:.04em;
  margin-bottom:16px;
  opacity:0;
  transform:scale(0.8);
  transition:opacity .3s ease, transform .3s ease;
}
.combo-display.active{
  opacity:1;transform:scale(1);
  background:linear-gradient(135deg,rgba(255,63,164,.15),rgba(201,166,255,.15));
  padding:12px 20px;border-radius:12px;
  border:1.5px solid rgba(242,216,143,.3);
  backdrop-filter:blur(8px);
}
.combo-label{
  font-size:.75rem;
  opacity:.6;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--gold-light);
}
.combo-count{
  font-size:2rem;
  font-weight:800;
  background:linear-gradient(135deg,var(--hot-pink),var(--lilac));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  display:block;
  animation:combo-pulse .25s ease;
}
.combo-bar{
  width:100%;max-width:120px;height:4px;
  background:rgba(255,255,255,.1);
  border-radius:2px;
  margin-top:8px;
  overflow:hidden;
}
.combo-bar-fill{
  height:100%;
  background:linear-gradient(90deg,var(--hot-pink),var(--lilac),var(--gold-light));
  border-radius:2px;
  transition:width .2s ease;
  box-shadow:0 0 12px rgba(255,63,164,.6);
}
@keyframes combo-pulse{
  0%{transform:scale(1.3);opacity:1;}
  100%{transform:scale(1);opacity:1;}
}
.combo-milestone{
  position:fixed;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  font-family:var(--font-display);
  font-size:clamp(1.5rem,8vw,3rem);
  background:linear-gradient(135deg,var(--hot-pink),var(--lilac));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  pointer-events:none;
  z-index:100;
  animation:milestone-burst .9s cubic-bezier(.2,.8,.2,1);
  font-weight:700;
  letter-spacing:.05em;
}
@keyframes milestone-burst{
  0%{transform:translate(-50%,-50%) scale(0);opacity:1;}
  50%{opacity:1;}
  100%{transform:translate(-50%,-50%) scale(2);opacity:0;}
}

.stage-progress{
  position:absolute;top:20px;right:20px;
  font-size:.8rem;
  color:rgba(255,255,255,.5);
  font-family:var(--font-ui);
  font-weight:600;
  letter-spacing:.04em;
}

.continue-btn{
  margin-top:38px;
  font-family:var(--font-ui);
  font-weight:700;
  font-size:.95rem;
  letter-spacing:.04em;
  color:var(--ink);
  background:linear-gradient(135deg,var(--gold-light),var(--gold));
  padding:13px 30px;
  border-radius:30px;
  box-shadow:0 8px 22px rgba(212,168,71,.35);
  opacity:0;
  pointer-events:none;
  transform:translateY(8px);
  transition:opacity .6s ease, transform .6s ease;
  border:1.5px solid rgba(212,168,71,.2);
  position:relative;
  overflow:hidden;
}
.continue-btn::before{
  content:'';
  position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);
  transform:translateX(-100%);
  animation:shimmer 2s infinite;
}
@keyframes shimmer{
  0%{transform:translateX(-100%);}
  100%{transform:translateX(100%);}
}
.continue-btn.revealed{
  opacity:1;pointer-events:auto;transform:translateY(0);
  box-shadow:0 12px 32px rgba(212,168,71,.5),0 0 20px rgba(242,216,143,.4);
}
.continue-btn.locked{
  opacity:.35;
  background:linear-gradient(135deg,#555,#333);
  color:#999;
  box-shadow:0 4px 12px rgba(0,0,0,.3);
}
.continue-btn:active:not(.locked){transform:scale(.96);}

.begin-btn{
  font-family:var(--font-ui);
  font-weight:700;
  font-size:1.05rem;
  letter-spacing:.04em;
  color:var(--ink);
  background:linear-gradient(135deg,#fff,var(--baby-pink));
  padding:16px 38px;
  border-radius:34px;
  box-shadow:0 10px 28px rgba(255,63,164,.35);
}
.begin-btn:active{transform:scale(.96);}

/* ---------- LANDING ---------- */
#stage-landing{
  background:radial-gradient(circle at 30% 20%, rgba(255,63,164,.35), transparent 55%),
             radial-gradient(circle at 75% 75%, rgba(201,166,255,.35), transparent 55%),
             linear-gradient(160deg,#2a1320,#1a0f17 60%);
}
.landing-name{
  font-family:var(--font-display);
  font-size:clamp(3.2rem,11vw,5.8rem);
  background:linear-gradient(90deg,var(--hot-pink),var(--lilac),var(--gold-light));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  line-height:1.05;
  margin-bottom:6px;
}
.landing-sub{
  font-family:var(--font-body);
  font-style:italic;
  color:#f4e9f0;
  font-size:clamp(1.05rem,2.6vw,1.3rem);
  margin-bottom:8px;
}
.landing-count{
  font-family:var(--font-ui);
  font-weight:600;
  color:var(--gold-light);
  font-size:.9rem;
  margin-bottom:36px;
  letter-spacing:.03em;
}

/* ---------- PINK STAGE ---------- */
#stage-pink{
  background:radial-gradient(circle at 50% 30%, rgba(255,63,164,.55), transparent 60%),
             linear-gradient(170deg,#3a0f2a,#1a0f17 65%);
}
.heart-wrap{
  margin:18px auto 6px;
  width:120px;height:120px;
  display:flex;align-items:center;justify-content:center;
  position:relative;
}
.heart-container{
  position:relative;
  width:100%;height:100%;
  display:flex;align-items:center;justify-content:center;
}
.heart{
  position:relative;width:64px;height:64px;
  transform:rotate(-45deg);
  background:var(--hot-pink);
  box-shadow:0 0 30px rgba(255,63,164,.6);
  transition:transform .25s ease;
  cursor:grab;
  user-select:none;
}
.heart.dragging{
  cursor:grabbing;
  box-shadow:0 0 40px rgba(255,63,164,.9),0 8px 20px rgba(255,63,164,.4);
}
.heart::before,.heart::after{
  content:'';position:absolute;width:64px;height:64px;border-radius:50%;background:var(--hot-pink);
}
.heart::before{top:-32px;left:0;}
.heart::after{top:0;left:32px;}
.heart-btn{
  display:inline-block;
  position:relative;
}
.heart-btn:active .heart{transform:rotate(-45deg) scale(.88);}
.heart-trail{
  position:absolute;
  width:20px;height:20px;
  border-radius:50%;
  pointer-events:none;
}
.pink-hint{
  font-size:.85rem;
  opacity:.6;
  margin-top:12px;
  color:rgba(255,255,255,.7);
  font-family:var(--font-ui);
}

/* ---------- LILY STAGE ---------- */
#stage-lily{
  background:radial-gradient(circle at 50% 25%, rgba(201,166,255,.4), transparent 60%),
             linear-gradient(170deg,#241a30,#1a0f17 65%);
}
.lily{
  position:relative;
  width:160px;
  height:190px;
  margin:10px auto 0;
  cursor:pointer;
  transform-style:preserve-3d;
}
.lily:hover{
  transform:scale(1.05);
}
.petal{
  position:absolute;left:50%;bottom:62px;width:24px;height:84px;
  background:linear-gradient(180deg,#ffffff,var(--lilac-light));
  border-radius:0 100% 0 100%;
  transform-origin:bottom center;
  transition:transform 1.2s cubic-bezier(.34,1.56,.64,1);
  cursor:pointer;
}
.petal:hover{
  filter:brightness(1.3);
}
@keyframes petal-shimmer{
  0%{filter:brightness(1.5);}
  100%{filter:brightness(1);}
}
.petal.p1{transform:translateX(-50%) rotate(2deg) scaleY(.38);}
.petal.p2{transform:translateX(-50%) rotate(-8deg) scaleY(.4);}
.petal.p3{transform:translateX(-50%) rotate(12deg) scaleY(.36);}
.petal.p4{transform:translateX(-50%) rotate(-14deg) scaleY(.38);}
.petal.p5{transform:translateX(-50%) rotate(18deg) scaleY(.34);}
.petal.p6{transform:translateX(-50%) rotate(-4deg) scaleY(.4);}
.lily.bloom .petal.p1{transform:translateX(-50%) rotate(0deg)   scaleY(1);}
.lily.bloom .petal.p2{transform:translateX(-50%) rotate(60deg)  scaleY(1);}
.lily.bloom .petal.p3{transform:translateX(-50%) rotate(120deg) scaleY(1);}
.lily.bloom .petal.p4{transform:translateX(-50%) rotate(180deg) scaleY(1);}
.lily.bloom .petal.p5{transform:translateX(-50%) rotate(240deg) scaleY(1);}
.lily.bloom .petal.p6{transform:translateX(-50%) rotate(300deg) scaleY(1);}
.lily-center{
  position:absolute;left:50%;bottom:56px;width:18px;height:18px;
  background:var(--gold);border-radius:50%;transform:translateX(-50%);
  box-shadow:0 0 14px var(--gold-light);
  transition:transform .3s ease, box-shadow .3s ease;
}
.lily:hover .lily-center{
  transform:translateX(-50%) scale(1.2);
  box-shadow:0 0 24px var(--gold-light);
}
.lily-stem{
  position:absolute;left:50%;bottom:0;width:4px;height:64px;
  background:#8FA37A;transform:translateX(-50%);border-radius:2px;
}

/* ---------- WINX / MAGIC STAGE ---------- */
#stage-winx{
  background:radial-gradient(circle at 50% 35%, rgba(201,166,255,.5), transparent 60%),
             linear-gradient(170deg,#2a1438,#1a0f17 65%);
  overflow:hidden;
}
.magic-flash{
  position:fixed;inset:0;z-index:5;
  background:conic-gradient(from 0deg,var(--hot-pink),var(--lilac),var(--gold-light),var(--hot-pink));
  opacity:0;mix-blend-mode:screen;pointer-events:none;
}
.magic-flash.burst{animation:spinFlash 1s ease-out forwards;}
@keyframes spinFlash{
  0%{opacity:0;transform:scale(.6) rotate(0deg);}
  35%{opacity:.6;}
  100%{opacity:0;transform:scale(1.6) rotate(140deg);}
}
.wand-btn{
  font-size:54px;
  display:inline-block;
  filter:drop-shadow(0 0 14px rgba(201,166,255,.7));
  transition:transform .25s ease;
  cursor:pointer;
  user-select:none;
  position:relative;
}
.wand-btn:hover{
  transform:scale(1.1) rotate(5deg);
  filter:drop-shadow(0 0 24px rgba(201,166,255,1));
}
.wand-btn:active{transform:scale(.85) rotate(-12deg);}
.magic-trail{
  position:absolute;
  width:16px;height:16px;
  border:2px solid var(--lilac);
  border-radius:50%;
  pointer-events:none;
  animation:trailFade .8s ease-out forwards;
}
@keyframes trailFade{
  0%{opacity:1;transform:scale(1);}
  100%{opacity:0;transform:scale(0);}
}

/* ---------- AUTUMN STAGE ---------- */
#stage-autumn{
  background:radial-gradient(circle at 50% 20%, rgba(212,168,71,.3), transparent 60%),
             linear-gradient(170deg,#3a2412,#1a0f17 65%);
}
.leaf-zone{height:160px;position:relative;margin-bottom:10px;}
.leaf{
  width:30px;height:40px;
  background:linear-gradient(160deg,var(--amber),var(--gold));
  border-radius:0 100% 0 100%;
  position:absolute;
  left:50%;top:6px;
  transform:translateX(-50%);
  cursor:pointer;
  box-shadow:0 0 16px rgba(212,168,71,.4);
}
.leaf.falling{
  animation:leafFall 2.1s ease-in forwards;
  pointer-events:none;
}
@keyframes leafFall{
  0%{transform:translateX(-50%) translateY(0) rotate(0deg);opacity:1;}
  100%{transform:translateX(-50%) translateY(150px) translate(50px,0) rotate(420deg);opacity:0;}
}
.wish-msg{
  font-family:var(--font-body);font-style:italic;
  font-size:1.05rem;opacity:0;transition:opacity .8s ease;
  min-height:1.4em;color:var(--amber-light);
}
.wish-msg.show{opacity:1;}

/* ---------- ROME STAGE ---------- */
#stage-rome{
  background:radial-gradient(circle at 50% 15%, rgba(212,168,71,.35), transparent 60%),
             linear-gradient(170deg,#352010,#1a0f17 65%);
}
.fountain-wrap{position:relative;width:240px;height:190px;margin:6px auto 14px;}
.column{
  position:absolute;bottom:0;width:18px;height:150px;
  background:repeating-linear-gradient(90deg, var(--cream) 0 2px, var(--gold-light) 2px 5px);
  border-top:6px solid var(--gold);border-bottom:6px solid var(--gold);
  border-radius:2px;
}
.column.left{left:0;}
.column.right{right:0;}
.tier{
  position:absolute;left:50%;transform:translateX(-50%);border-radius:50%;
  border:2px solid var(--gold);
  background:linear-gradient(180deg, rgba(212,168,71,.32), rgba(212,168,71,.1));
}
.tier1{bottom:0;width:170px;height:50px;}
.tier2{bottom:28px;width:115px;height:36px;}
.tier3{bottom:52px;width:64px;height:24px;}
.spout{
  position:absolute;left:50%;bottom:70px;width:5px;height:24px;
  background:var(--gold);transform:translateX(-50%);border-radius:3px;
}
.coin{
  position:absolute;left:50%;bottom:150px;transform:translateX(-50%);
  width:46px;height:46px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%, #FFE9B0, var(--gold) 75%);
  box-shadow:inset 0 0 8px rgba(0,0,0,.3), 0 4px 12px rgba(0,0,0,.35);
  cursor:pointer;
  z-index:3;
}
.coin.tossed{
  animation:coinToss 1.05s ease-in forwards;
  pointer-events:none;
}
@keyframes coinToss{
  0%{transform:translateX(-50%) translateY(0) rotateY(0deg) scale(1);}
  40%{transform:translateX(-46%) translateY(-110px) rotateY(540deg) scale(1.05);}
  100%{transform:translateX(-44%) translateY(40px) rotateY(900deg) scale(.35);opacity:0;}
}
.ripple{
  position:absolute;left:50%;bottom:24px;width:36px;height:36px;
  border:2px solid var(--gold-light);border-radius:50%;
  transform:translateX(-50%) scale(.2);opacity:.7;
  animation:rippleOut .9s ease-out forwards;
  z-index:2;
}
@keyframes rippleOut{
  to{transform:translateX(-50%) scale(2.6);opacity:0;}
}
.rome-msg{
  font-family:var(--font-body);font-style:italic;
  font-size:1.05rem;opacity:0;transition:opacity .8s ease;
  min-height:1.4em;color:var(--gold-light);
}
.rome-msg.show{opacity:1;}

/* ---------- FINAL STAGE ---------- */
#stage-final{
  background:radial-gradient(circle at 50% 20%, rgba(255,63,164,.25), transparent 60%),
             linear-gradient(170deg,#241018,#160c12 65%);
  overflow-y:auto;
  padding-top:70px;
}
.envelope-wrap{cursor:pointer;}
.envelope{
  position:relative;width:240px;height:156px;margin:10px auto 0;
  transition:opacity .6s ease, transform .6s ease;
}
.envelope.hidden{opacity:0;transform:scale(.85);pointer-events:none;}
.env-body{
  position:absolute;inset:0;border-radius:6px;
  background:linear-gradient(160deg,#FFD6EC,var(--cream));
  box-shadow:0 14px 34px rgba(0,0,0,.35);
}
.env-flap{
  position:absolute;top:0;left:0;width:100%;height:50%;
  background:linear-gradient(160deg,var(--hot-pink),var(--lilac));
  clip-path:polygon(0 0,100% 0,50% 100%);
  transform-origin:top;
  transition:transform .9s cubic-bezier(.4,0,.2,1);
  z-index:2;
}
.envelope.open .env-flap{transform:rotateX(180deg);}
.seal{
  position:absolute;top:36%;left:50%;transform:translate(-50%,-50%);
  width:36px;height:36px;border-radius:50%;background:var(--gold);
  display:flex;align-items:center;justify-content:center;font-size:16px;
  z-index:3;box-shadow:0 3px 8px rgba(0,0,0,.35);
}
.letter-card{
  max-width:540px;width:100%;margin:18px auto 60px;
  background:var(--cream);border:1px solid var(--gold-light);
  border-radius:14px;
  padding:clamp(26px,6vw,52px);
  box-shadow:0 24px 60px rgba(0,0,0,.4);
  text-align:left;
  opacity:0;transform:translateY(26px);
  transition:opacity .9s ease, transform .9s ease;
}
.letter-card.show{opacity:1;transform:translateY(0);}
.letter-card h2{
  font-family:var(--font-display);
  font-size:clamp(2.3rem,7vw,3.1rem);
  color:var(--deep-pink);
  margin-bottom:4px;
}
.letter-card .letter-kicker{
  font-family:var(--font-ui);font-size:.75rem;letter-spacing:.2em;
  text-transform:uppercase;color:var(--amber);margin-bottom:18px;
}
.letter-text p{
  font-family:var(--font-body);font-style:italic;
  font-size:clamp(1.08rem,2.4vw,1.28rem);
  line-height:1.75;color:var(--ink);margin-bottom:1rem;
}
.placeholder-note{
  border:1.5px dashed var(--lilac);padding:16px;border-radius:10px;
  color:#8a7a85;font-style:normal !important;background:rgba(201,166,255,.06);
}
.letter-final-count{
  margin-top:24px;padding-top:18px;border-top:1px dashed var(--gold-light);
  font-family:var(--font-ui);font-weight:600;font-size:.85rem;
  color:var(--deep-pink);text-align:center;
}

/* ---------- responsive ---------- */
@media (max-width:480px){
  .stage{padding:80px 18px 90px;}
