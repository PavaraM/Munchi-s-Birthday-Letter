# Copy to .env and adjust. .env is never committed (see .gitignore).

# ---- application / local dev ----
# http://localhost = plain HTTP (dev). A bare domain (munchi.duckdns.org) enables auto-HTTPS.
SITE_DOMAIN=http://localhost
APP_PORT=8080

# ---- production deploy (used by scripts/deploy.sh, scripts/rollback.sh, CI) ----
# VM_HOST=munchi.duckdns.org
# VM_USER=opc
# VM_SSH_PORT=22
# VM_SSH_KEY=~/.ssh/id_ed25519
# APP_IMAGE=ghcr.io/pavaram/munchi-birthday:latest
# APP_INTERNAL_PORT=80
